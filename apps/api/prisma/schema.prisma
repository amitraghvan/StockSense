// StockSense Prisma Schema
// Phase 01: Production Engineering Foundation
// Phase 02: Identity, Authentication, Authorization & Multi-Tenant Foundation
// Phase 03: Inventory Master Data & Storage Architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// Phase 03: Inventory Master Data Enums
// ==============================================================================

enum UnitOfMeasure {
  PCS
  KG
  G
  L
  ML
  BOX
  PACK
  SET
  PAIR
  M
  CM
  UNIT
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DISABLED
}

enum ReceiptStatus {
  DRAFT
  READY
  DONE
  CANCELLED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

/// Foundational system audit log for platform events and migrations verification.
model SystemAuditLog {
  id        String   @id @default(uuid())
  action    String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  metadata  Json?

  @@map("system_audit_logs")
}

/// Users represents unique human identities across the entire platform.
model User {
  id              String       @id @default(uuid())
  email           String       @unique @db.VarChar(255)
  passwordHash    String       @map("password_hash") @db.VarChar(255)
  name            String       @db.VarChar(150)
  status          UserStatus   @default(ACTIVE)
  emailVerifiedAt DateTime?    @map("email_verified_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  memberships         Membership[]
  sessions            Session[]
  passwordResetOtps   PasswordResetOtp[]
  auditLogs           IdentityAuditLog[]
  responsibleReceipts Receipt[]

  @@map("users")
}

/// Tenants represent distinct organizations / workspaces for multi-tenant isolation.
model Tenant {
  id        String       @id @default(uuid())
  name      String       @db.VarChar(150)
  slug      String       @unique @db.VarChar(150)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  memberships       Membership[]
  roles             Role[]
  auditLogs         IdentityAuditLog[]
  categories        Category[]
  products          Product[]
  warehouses        Warehouse[]
  locations         Location[]
  productLocations  ProductLocation[]
  receipts          Receipt[]
  receiptLines      ReceiptLine[]
  receiptSequences  ReceiptSequence[]
  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]

  @@map("tenants")
}

/// Roles define sets of permissions within the platform or scoped to a specific tenant.
model Role {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(true) @map("is_system")
  tenantId    String?  @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  memberships     Membership[]

  @@index([tenantId])
  @@index([name])
  @@map("roles")
}

/// Permissions are atomic capability keys representing authorized actions.
model Permission {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  module      String   @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Junction table binding Roles to granular Permissions.
model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Membership maps a User to a Tenant with a specific Role.
model Membership {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  tenantId  String           @map("tenant_id")
  roleId    String           @map("role_id")
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("memberships")
}

/// Sessions manage active authentication tokens and device tracking.
model Session {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tenantId   String?   @map("tenant_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  ipAddress  String?   @map("ip_address") @db.VarChar(100)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

/// Secure OTP records for password resets.
model PasswordResetOtp {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  otpHash             String    @map("otp_hash") @db.VarChar(255)
  attempts            Int       @default(0)
  resendCooldownUntil DateTime  @map("resend_cooldown_until")
  expiresAt           DateTime  @map("expires_at")
  usedAt              DateTime? @map("used_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_otps")
}

/// Audit log for identity, authentication, authorization, and tenant lifecycle events.
model IdentityAuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  tenantId  String?  @map("tenant_id")
  event     String   @db.VarChar(100)
  ipAddress String?  @map("ip_address") @db.VarChar(100)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tenantId])
  @@index([event])
  @@map("identity_audit_logs")
}

// ==============================================================================
// Phase 03: Inventory Master Data & Storage Architecture
// ==============================================================================

/// Product categories for inventory classification. Flat structure (no hierarchy).
model Category {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  name        String         @db.VarChar(150)
  description String?        @db.VarChar(500)
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("categories")
}

/// Products represent inventory items tracked by the system.
model Product {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  sku           String        @db.VarChar(50)
  name          String        @db.VarChar(200)
  description   String?       @db.VarChar(1000)
  categoryId    String?       @map("category_id")
  unitOfMeasure UnitOfMeasure @default(PCS) @map("unit_of_measure")
  barcode       String?       @db.VarChar(100)
  costPrice     Decimal?      @map("cost_price") @db.Decimal(12, 2)
  salePrice     Decimal?      @map("sale_price") @db.Decimal(12, 2)
  reorderLevel  Int?          @map("reorder_level")
  reorderQty    Int?          @map("reorder_qty")
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productLocations ProductLocation[]
  receiptLines     ReceiptLine[]
  inventoryBalances InventoryBalance[]
  stockMovements   StockMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, categoryId])
  @@index([tenantId, status])
  @@map("products")
}

/// Warehouses represent physical storage facilities.
model Warehouse {
  id          String          @id @default(uuid())
  tenantId    String          @map("tenant_id")
  name        String          @db.VarChar(150)
  code        String          @db.VarChar(20)
  address     String?         @db.VarChar(500)
  description String?         @db.VarChar(500)
  status      WarehouseStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations Location[]
  receipts  Receipt[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, name])
  @@map("warehouses")
}

/// Locations represent storage positions within a warehouse.
model Location {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  warehouseId String         @map("warehouse_id")
  name        String         @db.VarChar(150)
  shortCode   String         @map("short_code") @db.VarChar(30)
  description String?        @db.VarChar(500)
  status      LocationStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productLocations ProductLocation[]
  receiptLines     ReceiptLine[]
  inventoryBalances InventoryBalance[]
  stockMovements   StockMovement[]

  @@unique([warehouseId, shortCode])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([tenantId, warehouseId])
  @@map("locations")
}

/// Product-Location relationship foundation for the future stock engine.
/// Does NOT store quantities — that belongs to the transactional stock ledger.
model ProductLocation {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  productId  String   @map("product_id")
  locationId String   @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([tenantId])
  @@index([productId])
  @@index([locationId])
  @@map("product_locations")
}

// ==============================================================================
// Phase 04: Receipts & Incoming Inventory Operations
// ==============================================================================

/// Tenant-scoped, concurrency-safe counter for sequential receipt numbering.
model ReceiptSequence {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  prefix    String   @default("WH/IN") @db.VarChar(20)
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, prefix])
  @@map("receipt_sequences")
}

/// Receipts represent incoming inventory shipments entering a warehouse.
model Receipt {
  id                String        @id @default(uuid())
  tenantId          String        @map("tenant_id")
  reference         String        @db.VarChar(50)
  warehouseId       String        @map("warehouse_id")
  supplierName      String        @map("supplier_name") @db.VarChar(150)
  contactPerson     String?       @map("contact_person") @db.VarChar(150)
  responsibleUserId String?       @map("responsible_user_id")
  scheduleDate      DateTime      @map("schedule_date")
  status            ReceiptStatus @default(DRAFT)
  notes             String?       @db.VarChar(1000)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  completedAt       DateTime?     @map("completed_at")
  cancelledAt       DateTime?     @map("cancelled_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  responsibleUser User?           @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull)
  lines           ReceiptLine[]
  stockMovements  StockMovement[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([warehouseId])
  @@index([tenantId, scheduleDate])
  @@map("receipts")
}

/// Individual product line items within an incoming receipt.
model ReceiptLine {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  receiptId  String   @map("receipt_id")
  productId  String   @map("product_id")
  locationId String   @map("location_id")
  quantity   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipt  Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([receiptId])
  @@index([productId])
  @@index([locationId])
  @@map("receipt_lines")
}

/// Transactional inventory quantity on hand at each product-location bin.
model InventoryBalance {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  productId      String   @map("product_id")
  locationId     String   @map("location_id")
  quantityOnHand Int      @default(0) @map("quantity_on_hand")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([tenantId])
  @@index([productId])
  @@index([locationId])
  @@map("inventory_balances")
}

/// Minimal ledger recording immutable inventory mutations for audit history.
model StockMovement {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  receiptId    String?  @map("receipt_id")
  productId    String   @map("product_id")
  locationId   String   @map("location_id")
  quantity     Int
  movementType String   @default("RECEIPT") @map("movement_type") @db.VarChar(30)
  reference    String   @db.VarChar(50)
  performedBy  String?  @map("performed_by")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipt  Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([receiptId])
  @@index([productId])
  @@index([locationId])
  @@map("stock_movements")
}
