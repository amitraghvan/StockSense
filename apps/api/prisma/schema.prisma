// StockSense Prisma Schema
// Phase 01: Production Engineering Foundation
// Phase 02: Identity, Authentication, Authorization & Multi-Tenant Foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DISABLED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

/// Foundational system audit log for platform events and migrations verification.
model SystemAuditLog {
  id        String   @id @default(uuid())
  action    String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  metadata  Json?

  @@map("system_audit_logs")
}

/// Users represents unique human identities across the entire platform.
model User {
  id              String       @id @default(uuid())
  email           String       @unique @db.VarChar(255)
  passwordHash    String       @map("password_hash") @db.VarChar(255)
  name            String       @db.VarChar(150)
  status          UserStatus   @default(ACTIVE)
  emailVerifiedAt DateTime?    @map("email_verified_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  memberships       Membership[]
  sessions          Session[]
  passwordResetOtps PasswordResetOtp[]
  auditLogs         IdentityAuditLog[]

  @@map("users")
}

/// Tenants represent distinct organizations / workspaces for multi-tenant isolation.
model Tenant {
  id        String       @id @default(uuid())
  name      String       @db.VarChar(150)
  slug      String       @unique @db.VarChar(150)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  memberships Membership[]
  roles       Role[]
  auditLogs   IdentityAuditLog[]

  @@map("tenants")
}

/// Roles define sets of permissions within the platform or scoped to a specific tenant.
model Role {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(true) @map("is_system")
  tenantId    String?  @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  memberships     Membership[]

  @@index([tenantId])
  @@index([name])
  @@map("roles")
}

/// Permissions are atomic capability keys representing authorized actions.
model Permission {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  module      String   @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Junction table binding Roles to granular Permissions.
model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Membership maps a User to a Tenant with a specific Role.
model Membership {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  tenantId  String           @map("tenant_id")
  roleId    String           @map("role_id")
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("memberships")
}

/// Sessions manage active authentication tokens and device tracking.
model Session {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tenantId   String?   @map("tenant_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  ipAddress  String?   @map("ip_address") @db.VarChar(100)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

/// Secure OTP records for password resets.
model PasswordResetOtp {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  otpHash             String    @map("otp_hash") @db.VarChar(255)
  attempts            Int       @default(0)
  resendCooldownUntil DateTime  @map("resend_cooldown_until")
  expiresAt           DateTime  @map("expires_at")
  usedAt              DateTime? @map("used_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_otps")
}

/// Audit log for identity, authentication, authorization, and tenant lifecycle events.
model IdentityAuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  tenantId  String?  @map("tenant_id")
  event     String   @db.VarChar(100)
  ipAddress String?  @map("ip_address") @db.VarChar(100)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tenantId])
  @@index([event])
  @@map("identity_audit_logs")
}
