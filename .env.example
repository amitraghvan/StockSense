# ==============================================================================
# StockSense Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Application Identification
APP_NAME=stocksense
APP_VERSION=0.1.0

# Backend API Configuration
PORT=4000
API_PREFIX=api/v1
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Frontend Web Configuration
NEXT_PUBLIC_APP_NAME=StockSense
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://amitkumar:@localhost:5432/stocksense_dev?schema=public
# Docker compose default alternative:
# DATABASE_URL=postgresql://stocksense:stocksense_secret@localhost:5432/stocksense_dev?schema=public

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Logging Level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Phase 02: Authentication & Security Tokens
JWT_ACCESS_SECRET=stocksense_jwt_access_super_secret_for_development_minimum_32_characters_long_12345
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=stocksense_jwt_refresh_super_secret_for_development_minimum_32_characters_long_67890
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=stocksense_cookie_super_secret_for_development_minimum_32_characters_long_54321

# Phase 02: OTP Security Configuration
OTP_TTL_SECONDS=600
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
